# Copy to voice-agent/.env (gitignored) for local runs; set the same names in Coolify for production.

# Dialogue brain (Claude)
ANTHROPIC_API_KEY=
VOICE_MODEL=claude-sonnet-5-5
VOICE_EFFORT=low

# Speech (ElevenLabs): STT Scribe v2, TTS Eleven v4 turbo (fastest Persian-capable; Flash/Turbo v2.5 lack Persian)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
STT_MODEL=scribe_v2
STT_LANGUAGE=fas
TTS_MODEL=eleven_v4_turbo

# The clinic website that owns /api/slots and /api/book
BOOKING_API_BASE=http://localhost:3000

PORT=3100
